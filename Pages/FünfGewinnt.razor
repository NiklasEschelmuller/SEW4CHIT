@page "/Home"
<h3>Fünfgewinnt</h3>

@for (int r = 0; r < 18; r++)
{
    <div>
        @for (int c = 0; c < 18; c++)
        {
            int x = c, y = r;
            <button class="btn btn-primary btn-size" onclick="(Set(x,y)">@_game[c,r]</button>
        }
    </div>
}

<button class="btn btn-primary " @onclick="()=>_game = new FünfGeGame()">Reset</button>
@code {
    private FünfGeGame _game = new();

    private void Set(int x, int y)
    {
        _game.Set(x, y);
    }
}