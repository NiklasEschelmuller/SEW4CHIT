@page "/Fünfgewinnt"
<h3>Minesweeper</h3>

@for (int r = 0; r < ROWS; r++)
{
    <div>
        @for (int c = 0; c < COLS; c++)
        {
            int x = c, y = r;
            <button class="btn btn-primary btn-size" @onclick="() => Click(x, y)">@_game[x, y]</button>
        }
    </div>
}

<button class="btn btn-primary" @onclick="Reset">Reset</button>

@code {
    static int COLS = 10;
    static int ROWS = 10;
    private Minesweeper _game = new(COLS, ROWS);

    private void Click(int c, int r)
    {
        _game[c, r] = " ";  
        StateHasChanged(); 
    }

    private void Reset()
    {
        _game = new Minesweeper(COLS, ROWS);
    }
}