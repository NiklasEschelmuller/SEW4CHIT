@page "/Fünfgewinnt"
<h3>Minesweeper</h3>

@for (int r = 0; r < ROWS; r++)
{
    <div>
        @for (int c = 0; c < COLS; c++)
        {
            <button class="btn btn-primary btn-size)">@_game[c,r]</button>
        }
    </div>
}

<button class="btn btn-primary " @onclick="()=>_game = new Minesweeper(COLS, ROWS)">Reset</button>


@code {
    static int COLS = 5;
    static int ROWS = 3;
    private Minesweeper _game = new(COLS,ROWS);
}