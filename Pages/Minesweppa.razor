@page "/Fünfgewinnt"
<h3>Minesweeper</h3>

@for (int r = 0; r < 15; r++)
{
    <div>
        @for (int c = 0; c < 15; c++)
        {
            int x = c, y = r;
            <button class="btn btn-primary btn-size" onclick="(Set(x,y)"></button>
        }
    </div>
}

<button class="btn btn-primary " @onclick="()=>_game = new Minesweeper()">Reset</button>


@code {
    private Minesweeper _game = new();

    private void Set(int x, int y)
    {
        _game.Set(x, y);
    }
}