@using MySql.Data.MySqlClient
@page "/weather"
@attribute [StreamRendering]

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Value</th>
        <th>Aktion</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in entries)
    {
        <tr>
            <td>@entry.Id</td>
            <td>
                @if (editingId == entry.Id)
                {
                    <input @bind="editingValue" />
                }
                else
                {
                    @entry.Value
                }
            </td>
            <td>
                @if (editingId == entry.Id)
                {
                    <button @onclick="() => SaveEdit(entry.Id)">Speichern</button>
                    <button @onclick="CancelEdit">Abbrechen</button>
                }
                else
                {
                    <button @onclick="() => StartEdit(entry)">Bearbeiten</button>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@code {

    private List<Test> entries = new();
    private MySqlConnection _connection = new ("server=localhost;user=root;password=insy;database=demo");

    private int? editingId = null;
    private string editingValue;

    protected override void OnInitialized()
    {
        LoadEntries();
    }

    private void LoadEntries()
    {
        entries.Clear();
        _connection.Open();

        using var command = new MySqlCommand("SELECT * FROM test;", _connection);
        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            int id = reader.GetInt32(0);
            string value = reader.GetString(1);
            entries.Add(new Test { Id = id, Value = value });
        }

        _connection.Close();
    }

    private void StartEdit(Test entry)
    {
        editingId = entry.Id;
        editingValue = entry.Value;
    }

    private void SaveEdit(int id)
    {
        _connection.Open();
        using var command = new MySqlCommand("UPDATE test SET value = @value WHERE id = @id;", _connection);
        command.Parameters.AddWithValue("@value", editingValue);
        command.Parameters.AddWithValue("@id", id);
        command.ExecuteNonQuery();
        _connection.Close();

        editingId = null;
        LoadEntries();
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private class Test
    {
        public int Id { get; set; }
        public string Value { get; set; }
    }
}