@using MySql.Data.MySqlClient
@page "/weather"
@attribute [StreamRendering]

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Value</th>
        <th>Aktion</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var entry in entries)
    {
        <tr>
            <td>@entry.Id</td>
            <td>@entry.Value</td>
            <td>
                <button @onclick="() => DeleteEntry(entry.Id)">Löschen</button>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {

    private List<Test> entries = new();
    private MySqlConnection _connection = new ("server=localhost;user=root;password=insy;database=demo");

    protected override void OnInitialized()
    {
        LoadEntries();
    }

    private void LoadEntries()
    {
        entries.Clear();
        _connection.Open();

        using var command = new MySqlCommand("SELECT * FROM test;", _connection);
        using var reader = command.ExecuteReader();

        while (reader.Read())
        {
            int id = reader.GetInt32(0);
            string value = reader.GetString(1);
            entries.Add(new Test { Id = id, Value = value });
        }

        _connection.Close();
    }

    private void DeleteEntry(int id)
    {
        _connection.Open();
        using var command = new MySqlCommand("DELETE FROM test WHERE id = @id;", _connection);
        command.Parameters.AddWithValue("@id", id);
        command.ExecuteNonQuery();
        _connection.Close();

        entries.RemoveAll(e => e.Id == id);
        StateHasChanged();
    }

    private class Test
    {
        public int Id { get; set; }
        public string Value { get; set; }
    }
}